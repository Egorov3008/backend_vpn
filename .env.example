# ===================================================================
# BACKEND ENVIRONMENT CONFIGURATION
# ===================================================================
#
# SETUP:
#   $ cp .env.example .env
#   $ vim .env
#   $ docker compose up -d
#
# This .env is used by the `backend` app (docker-compose.yml). The compose
# stack runs its own postgres service (`postgres`, backend_net network); the
# database is reachable only from backend, not from clients or the host.
#
# Clients (bot, web, ...) reach backend only over its HTTP API. Their
# secrets must match the ones here:
#   BOT_SECRET_KEY           — shared secret for client→Backend calls (X-Bot-Secret)
#   ADMIN_API_KEY            — shared secret for admin operations (X-API-Key)
# There is no automated sync — update both sides by hand when rotating.
# ===================================================================

# === PostgreSQL (backend's own container; hostname `postgres` is the compose service) ===
DB_NAME=vpn_bot
DB_USER=vpn_user
DB_PASSWORD=changeme
DATABASE_URL=postgresql://vpn_user:changeme@postgres:5432/vpn_bot

# === Security (shared with clients — see note above) ===
BOT_SECRET_KEY=generate-a-strong-secret-32-chars
ADMIN_API_KEY=generate-a-strong-secret-32-chars
INVITE_TOKEN=web_invite_2026

# === 3x-UI Panel ===
XUI_API_URL=http://your-panel:2095
XUI_LOGIN=admin
XUI_PASSWORD=admin_password
XUI_SERVER_ID=1
XUI_SUB=https://your-domain.com:2096
# Decorative-ссылка, прописываемая в панели (externalLinks) на create/renew.
# НЕ используется как рабочая ссылка подписки — та строится из XUI_SUB.
EXTERNAL_SUB_URL=https://your-domain.com:2096/external-sub-path
XUI_SKIP_SSL_VERIFY=false

# === Landing page (Telegram-доступ без регистрации) ===
XUI_INBOUND_ID_LANDING=0
# HMAC-секрет для подписи куки tg_landing_id. Если пусто — используется BOT_SECRET_KEY.
LANDING_COOKIE_SECRET=
LANDING_PUBLIC_URL=https://telegram.example.com
# Секрет только для бота: /landing/claim и /landing/mark-converted (заголовок
# X-Landing-Internal-Secret). nginx его не подставляет. Пусто = маршруты закрыты.
LANDING_INTERNAL_SECRET=

# === YooKassa (Payment Processing) ===
YOOKASSA_SHOP_ID=123456
YOOKASSA_SECRET_KEY=test_xxxxxxxxxxxxx
DISABLE_WEBHOOK_IP_CHECK=false
RECEIPT_CUSTOMER_EMAIL=

# === Telegram (backend sends notifications via bot_project.py, no aiogram) ===
BOT_TOKEN=your_telegram_bot_token
BOT_NAME=MyVPNBot
SUPPORT_CHAT_URL=https://t.me/support_chat
CANALL_URL=https://t.me/your_channel

# === Bot Behavior / Tariffs ===
ADMIN_ID=[123456789]
ADMIN_TG_IDS=[123456789]
AVAILABLE_RATES=[9, 8, 7]
AVAILABLE_CONNECTIONS=[11, 12]
DEFAULT_PRICING_PLAN=10
CHANNEL_BONUS_DAYS=7
TRIAL_TIME=30
DISCOUNTS=3
LIMIT_IP=3

# === Webhook Configuration ===
WEBHOOK_PATH=/api/v1/payments/webhook
WEBHOOK_BASE_URL=https://your-domain.com

# Safety net для пропущенных webhook'ов YooKassa: фоновый опрос pending-платежей.
PAYMENT_SWEEP_MAX_AGE_MINUTES=1440
PAYMENT_SWEEP_EXCLUDE_IDS=

# === Logging ===
LOG_LEVEL=INFO
LOG_FILE=
LOG_FORMAT=detailed

# === Monitoring ===
METRICS_PORT=9101

# === MVP shared-config endpoint ===
MVP_APP_SECRET=changeme

# Telegram Mini App (/api/v1/miniapp). Session token HMAC key; required (openssl rand -hex 32).
MINIAPP_SESSION_SECRET=changeme
# Публичный https-адрес Mini App: кнопки уведомлений (продление, триал) открывают её. Пусто — старые callback'и бота
MINIAPP_URL=
MINIAPP_SESSION_TTL_SECONDS=3600
MINIAPP_INIT_DATA_MAX_AGE_SECONDS=86400
MVP_SHARED_KEY_EMAIL=
